{
  "name": "kmx",
  "description": "Web GUI for CNC",
  "version": "1.0.0",
  "jsnext:main": "esm/main.js",
  "main": "./index.js",
  "browser": "app/main",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "lint": "npx eslint",
    "tsc": "tsc",
    "dev": "webpack-dev-server --progress --profile --stats-children --port 8081",
    "aot": "webpack --config config/webpack.aot.babel.js --progress --profile --bail",
    "aot:serve": "webpack-dev-server --config config/webpack.aot.babel.js --progress --profile --bail  --port 8081",
    "build": "rimraf ../kmx && webpack --config config/webpack.prod.js --progress --profile --bail",
    "build:dev": "rimraf dist && webpack --config config/webpack.dev.js --progress --profile --bail",
    "analyze": "rimraf ../kmx && webpack --config config/webpack.analyze.js --progress --profile --bail"
  },
  "license": "ISC",
  "dependencies": {
    "@angular/animations": "^18.2.9",
    "@angular/common": "^18.2.9",
    "@angular/compiler": "^18.2.9",
    "@angular/core": "^18.2.9",
    "@angular/forms": "^18.2.9",
    "@angular/platform-browser": "^18.2.9",
    "@angular/platform-browser-dynamic": "^18.2.9",
    "@angular/platform-server": "^18.2.9",
    "@angular/router": "^18.2.9",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "bootstrap": "^4.6.0",
    "brace": "^0.11.1",
    "core-js": "^3.38.1",
    "decimal.js": "^10.2.0",
    "ngx-bootstrap": "^18.1.2",
    "rxjs": "^7.4.0",
    "three": "^0.110.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular/language-service": "^18.2.9",
    "@typescript-eslint/parser": "^8.11.0",
    "@stylistic/eslint-config": "^1.1.0",
    "@stylistic/eslint-plugin-ts":"^2.9.0",
    "angular2-template-loader": "^0.6.2",
    "codelyzer": "^6.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.13.0",
    "eslint-define-config": "^2.1.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.1",
    "raw-loader": "^4.0.0",
    "rimraf": "^6.0.1",
    "to-string-loader": "^1.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "5.6.3",
    "webpack": "^5.95.0",
    "webpack-bundle-analyzer": "^3.6.0",
    "webpack-cli": "^5.1.4",
