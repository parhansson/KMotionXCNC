{
  "name": "kmx",
  "description": "Web GUI for CNC",
  "version": "1.0.0",
  "jsnext:main": "esm/main.js",
  "main": "./index.js",
  "browser": "app/main",
  "scripts": {
    "ng": "ng",
    "lint": "tslint --fix --project ./",
    "tsc": "tsc",
    "tscw": "tsc -w",
    "serve": "webpack-dev-server --progress --profile --port 8081",
    "aot": "webpack --config config/webpack.aot.babel.js --progress --profile --bail",
    "aot:serve": "webpack-dev-server --config config/webpack.aot.babel.js --progress --profile --bail  --port 8081",
    "build": "rimraf ../kmx && webpack --config config/webpack.prod.js --progress --profile --bail",
    "build:dev": "rimraf dist && webpack --config config/webpack.dev.js --progress --profile --bail",
    "analyze": "rimraf ../kmx && webpack --config config/webpack.analyze.js --progress --profile --bail"
  },
  "license": "ISC",
  "dependencies": {
    "@angular/animations": "^15.2.1",
    "@angular/common": "^15.2.1",
    "@angular/compiler": "^15.2.1",
    "@angular/core": "^15.2.1",
    "@angular/forms": "^15.2.1",
    "@angular/platform-browser": "^15.2.1",
    "@angular/platform-browser-dynamic": "^15.2.1",
    "@angular/platform-server": "^15.2.1",
    "@angular/router": "^15.2.1",
    "@fortawesome/fontawesome-free":"^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "bootstrap": "^4.6.0",
    "brace": "^0.11.1",
    "core-js": "^3.9.0",
    "decimal.js": "^10.2.0",
    "ngx-bootstrap": "^10.3.0",
    "rxjs": "^7.4.0",
    "three": "^0.110.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular/language-service": "^15.2.1",
    "angular2-template-loader": "^0.6.2",
    "codelyzer": "^6.0.0",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.1",
    "raw-loader": "^4.0.0",
    "rimraf": "^6.0.1",
    "to-string-loader": "^1.2.0",
    "ts-loader": "^9.5.1",
    "tslint": "~6.1.0",
    "tslint-loader": "^3.6.0",
    "typescript": "5.6.3",
    "webpack": "^5.95.0",
    "webpack-bundle-analyzer": "^3.6.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  }
}